# 배포된 이미지 태그 — 이 파일의 SHA만 바꾸고 ./deploy.sh 를 실행하면 반영된다.
# 값은 커밋 SHA 40자리 전체(실제 태그는 "sha-" + 이 값). 확인: ./deploy.sh --check
#
# 변수가 여러 개인 이유: 워크플로우마다 트리거되는 경로가 달라서, 한 커밋에서 일부
# 이미지만 빌드되는 일이 흔하다. 예를 들어 backend/만 고친 커밋에서는 frontend 이미지가
# 만들어지지 않는다. 그 커밋 SHA를 frontend에도 쓰면 "이미지 없음"으로 배포가 멈춘다.
# 반드시 ./deploy.sh --check 로 실제 빌드된 SHA를 확인하고 채울 것.

# backend + ai — 한 워크플로우(backend-ai-images.yml)가 함께 빌드하므로 항상 같은 값
# 트리거 경로: backend/, frontend/, AI/
BACKEND_SHA=4ebb27240c4c1192ed4f03a848deadccdf0118d5

# frontend — 별도 워크플로우(frontend-image.yml)
# 트리거 경로: frontend/, nginx/
FRONTEND_SHA=5ea821256229cecd5326074b0ef527a89d0f96b3

# embed — 챗봇 RAG용 임베딩 서비스 (embed-image.yml)
# 트리거 경로: embed/
EMBED_SHA=3551b454be77cf402fd143e1229f042e7bca6828

# mysql — database/ 폴더가 바뀔 때만 빌드 (database-image.yml)
DB_SHA=c03634e203a001db403fbf14acab0b6a17c2ccfd

# ticketing-demo — ticketing-demo-site 저장소 (별도 저장소, 별도 CI)
DEMO_SHA=63af0551e0d307f4765470ec00911fb8a21896e9
