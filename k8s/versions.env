# 배포된 이미지 태그 — 이 파일의 SHA만 바꾸고 ./deploy.sh 를 실행하면 반영된다.
# 값은 커밋 SHA 40자리 전체(실제 태그는 "sha-" + 이 값). 확인: ./deploy.sh --check

# backend, ai, frontend — AI-Captcha 저장소
APP_SHA=5d7a0190b177cc58b1d24c37b3d4e58df8663e6c

# ticketing-demo — ticketing-demo-site 저장소 (별도 CI)
DEMO_SHA=e8c136f4ee0637e003e545e4b13bd52f9e754138

# mysql — database/ 폴더가 바뀔 때만 빌드되므로 APP_SHA와 다른 게 정상
DB_SHA=c03634e203a001db403fbf14acab0b6a17c2ccfd

# embed — 챗봇 RAG용 임베딩 서비스. embed/ 폴더가 바뀔 때만 빌드된다.
EMBED_SHA=0000000000000000000000000000000000000000
